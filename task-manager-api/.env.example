# Obrigatoria, exceto com APP_DEBUG=1 (desenvolvimento).
SECRET_KEY=
# 1 liga o modo debug (padrao: 0)
APP_DEBUG=0
# Padrao: apenas local. Use 0.0.0.0 somente se precisar expor a API na rede.
HOST=127.0.0.1
PORT=5000
DATABASE_URL=sqlite:///tasks.db
# Validade do token de login, em segundos
TOKEN_MAX_AGE=3600
LOG_LEVEL=INFO
# Origens de navegador permitidas pelo CORS, separadas por virgula (ex.: http://localhost:3000).
# Vazio = nenhuma origem de navegador; curl e outros servicos nao sao afetados.
CORS_ORIGINS=
