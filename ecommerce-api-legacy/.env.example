# Porta HTTP (padrão: 3000)
PORT=3000

# Token das rotas administrativas (GET /api/admin/financial-report e DELETE /api/users/:id).
# Enviado como "Authorization: Bearer <token>". Sem ele, essas rotas respondem 401.
ADMIN_TOKEN=

# Nível de log: error | warn | info | debug (padrão: info)
LOG_LEVEL=info
