# Copie para o ambiente (exporte as variáveis); este arquivo não contém segredos.
# Obrigatória, exceto com APP_DEBUG=1 (que gera uma chave temporária só para desenvolvimento).
SECRET_KEY=
# 1 liga o modo debug do Flask (nunca em produção)
APP_DEBUG=0
# Padrão seguro: apenas local. Use 0.0.0.0 somente se precisar expor na rede.
HOST=127.0.0.1
PORT=5000
DATABASE_URL=loja.db
# Validade do token de login, em segundos
TOKEN_MAX_AGE=3600
LOG_LEVEL=INFO
APP_ENV=producao
